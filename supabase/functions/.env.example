# Edge Function environment values. Keep server-only secrets out of client apps and EXPO_PUBLIC/VITE variables.
SUPABASE_URL=http://127.0.0.1:54321
# Public project API key used with the caller's JWT by userClient.ts. Never use a service-role key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_LOCAL_OR_PROJECT_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_OR_PROJECT_SERVICE_ROLE_KEY
AMAR_BAZAR_WORKER_SECRET=REPLACE_WITH_LONG_RANDOM_INTERNAL_SECRET
META_ACCESS_TOKEN=REPLACE_WITH_META_CLOUD_API_TOKEN
META_PHONE_NUMBER_ID=REPLACE_WITH_META_PHONE_NUMBER_ID
META_API_VERSION=SET_A_SUPPORTED_META_GRAPH_API_VERSION
META_TEMPLATE_LANGUAGE=bn
ADMIN_WHATSAPP_PHONE=+8801XXXXXXXXX
WHATSAPP_DRY_RUN=true
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_SEPARATE_WEBHOOK_VERIFY_TOKEN
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
